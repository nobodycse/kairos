# KAIROS 环境变量模板（design.md §7）
# 复制为同目录 .env 后填写；.env 不入库（.gitignore 已排除）
#   cp .env.example .env
# compose 部署时会自动读取本目录 .env 做变量替换与 env_file 注入

# ---------- 后端（backend 容器） ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
# compose 部署时此值会被 docker-compose.yml 的 environment 覆盖
# （密码统一取 POSTGRES_PASSWORD，只需改一处）
DATABASE_URL=postgresql+asyncpg://kairos:CHANGE_ME@postgres:5432/kairos
REDIS_URL=redis://redis:6379/0
# 随机 32+ 字符，例如：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_PLUS_CHARS
JWT_EXPIRE_HOURS=24
# backend 容器内路径：改写过 server 地址的 k3s kubeconfig 副本
KUBECONFIG=/kubeconfig/k3s.yaml
DEMO_NAMESPACE=demo

# ---------- 部署（compose / CI/CD） ----------
POSTGRES_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Gitee WebHook 的「密码」，X-Gitee-Token 头携带此值做校验
WEBHOOK_SECRET=CHANGE_ME
# 宿主机内网 IP，setup_server.sh 用它改写 k3s.yaml 的 server 地址
K3S_SERVER_IP=10.0.0.10
